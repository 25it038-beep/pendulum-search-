# HS SEARCH - Environment Configuration
# Company: HS AI Solutions
# Founder: Harshan Seliyan

HS_HOST=0.0.0.0
HS_PORT=8000
HS_DEBUG=true

# Crawler Politeness & Concurrency
CRAWLER_MAX_CONCURRENCY=12
CRAWLER_DOMAIN_DELAY_SEC=1.0
CRAWLER_TIMEOUT=15
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PER_DOMAIN=100

# OpenSearch Configuration (Optional distributed clustering)
USE_OPENSEARCH=false
OPENSEARCH_URL=http://localhost:9200

# Qdrant Configuration (Optional distributed vector store)
USE_QDRANT=false
QDRANT_URL=http://localhost:6333

# AI Model Keys (Optional external LLMs for synthesis)
GEMINI_API_KEY=
OPENAI_API_KEY=
