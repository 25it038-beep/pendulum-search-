# ============================================================
# Pendulum Search — Environment Variables
# Company: HS AI Solutions | Founder: Harshan Seliyan
#
# Copy this file to .env and fill in values before running.
# On Railway: add each variable in the "Variables" tab.
# ============================================================

# --- Server ---
HS_HOST=0.0.0.0
HS_PORT=8000
HS_DEBUG=false

# --- Database / Storage ---
# Railway: set DATA_DIR to a path on your persistent volume (e.g. /app/data)
# Local:   leave empty to use backend/data/
DATA_DIR=/app/data

# --- Crawler ---
CRAWLER_MAX_CONCURRENCY=6
CRAWLER_DOMAIN_DELAY_SEC=1.0
CRAWLER_TIMEOUT=15
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PER_DOMAIN=100

# --- July AI Backend (HS AI Solutions private cloud) ---
JULY_CLOUD_ENABLED=true
JULY_CLOUD_ENDPOINT=https://it038--july-llm-cloud-julylitemodalservice-serve.us-east.modal.run/v1/chat/completions
JULY_CLOUD_API_KEY=hs-july-cloud-key-secure
JULY_CLOUD_MODEL=july-lite
JULY_CLOUD_TIMEOUT_SEC=20.0

# --- NVIDIA AI Inference Gateway ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_MODEL_QUALITY=meta/llama-3.2-90b-vision-instruct
NVIDIA_TIMEOUT_SEC=15.0

# --- External Search Providers ---
ENABLE_EXTERNAL_PROVIDERS=true
EXTERNAL_PROVIDER_TIMEOUT_SEC=1.5
# Optional: self-hosted SearXNG URL for richer external results
SEARXNG_URL=

# --- Hybrid Search Weights ---
PENDULUM_PROVIDER_WEIGHT=1.20
DDG_PROVIDER_WEIGHT=1.00
HYBRID_DDG_TIMEOUT_SEC=2.5
HYBRID_PENDULUM_TIMEOUT_SEC=4.0
HYBRID_CACHE_TTL_SEC=300

# --- OpenSearch (optional distributed full-text engine) ---
USE_OPENSEARCH=false
OPENSEARCH_URL=http://localhost:9200

# --- Qdrant (optional distributed vector store) ---
USE_QDRANT=false
QDRANT_URL=http://localhost:6333

# --- Modal / MegaCrawler ---
MODAL_ENABLED=false
REDIS_URL=redis://localhost:6379/0
USE_REDIS_FRONTIER=false
