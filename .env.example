# ============================================================
# Pendulum Search — Node.js / TypeScript Environment Variables
# Company: HS AI Solutions | Founder: Harshan Seliyan
#
# Copy this to .env and fill in values before running locally.
# On Railway: add each key-value in the "Variables" tab.
# ============================================================

# --- Server ---
NODE_ENV=production
PORT=3000
APP_PORT=3000

# --- PostgreSQL Database (Railway provides DATABASE_URL automatically) ---
# If Railway provides a DATABASE_URL connection string, use it directly:
DATABASE_URL=postgresql://user:password@host:5432/dbname

# OR set individual fields if using Drizzle config:
SQL_HOST=your-db-host.railway.app
SQL_PORT=5432
SQL_DB_NAME=railway
SQL_USER=postgres
SQL_PASSWORD=your-database-password
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=your-database-password

# --- Firebase Admin SDK ---
# Set GOOGLE_APPLICATION_CREDENTIALS to your service account JSON path, OR
# set FIREBASE_PROJECT_ID and use Application Default Credentials
FIREBASE_PROJECT_ID=woven-marking-x9brs

# --- July AI Backend (HS AI Solutions private cloud) ---
JULY_CLOUD_ENABLED=true
JULY_CLOUD_ENDPOINT=https://it038--july-llm-cloud-julylitemodalservice-serve.us-east.modal.run/v1/chat/completions
JULY_CLOUD_API_KEY=hs-july-cloud-key-secure
JULY_CLOUD_MODEL=july-lite

# --- NVIDIA AI Inference Gateway ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- External Search Providers ---
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# --- Crawler ---
CRAWLER_MAX_CONCURRENCY=6
CRAWLER_DOMAIN_DELAY_SEC=1.0
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PER_DOMAIN=100
CRAWLER_TIMEOUT=15
